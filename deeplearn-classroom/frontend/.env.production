# ─── Production Environment Variables ────────────────────────────────────────
# This file is baked into the Vite production build.
# It is committed to the repo so Vercel can use it at build time.
#
# If VITE_API_URL is also set as a Vercel Environment Variable,
# the Vercel dashboard value will take precedence over this file.
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=https://deeplearn-classroom.onrender.com

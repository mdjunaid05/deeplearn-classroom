# ─────────────────────────────────────────────────────────────────────────────
# DeepLearn Classroom — Backend Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env to git (it contains secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-random-secret-key-here-at-least-32-chars

# ── Server ────────────────────────────────────────────────────────────────────
# Render/Railway inject PORT automatically. Leave blank locally (defaults to 5000).
PORT=5000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (e.g. https://deeplearn-classroom.vercel.app)
# Use * to allow all origins during development.
CORS_ORIGINS=*

# ── Python ────────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ── Whisper Speech-to-Text ────────────────────────────────────────────────────
# Set RENDER=true to bypass Whisper (free tier has only 512MB RAM)
RENDER=false
USE_WHISPER=false
WHISPER_MODEL=tiny   # Options: tiny, base, small, medium, large

# ── MySQL Database (optional) ─────────────────────────────────────────────────
# If not set, SQLite is used automatically (great for local dev).
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=your-mysql-password
# DB_NAME=deeplearn_classroom

# ── Cloudflare R2 Video Storage ───────────────────────────────────────────────
# Get these from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
#
# How to set up (5 min):
#   1. Go to Cloudflare Dashboard → R2 Object Storage → Create Bucket
#      Name: deeplearn-videos
#   2. Bucket Settings → Public Access → Allow public access → Save
#   3. R2 → Manage R2 API Tokens → Create Token
#      Permissions: Object Read & Write on bucket "deeplearn-videos"
#   4. Copy the 4 values below
#   5. In Render dashboard → Environment → add as Secret variables
#
# Without these vars, videos are stored on local disk (disappear on redeploy).

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=deeplearn-videos
# Public URL from: Cloudflare → R2 → deeplearn-videos → Settings → Public URL
# Looks like: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
